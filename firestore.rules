rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isVaultMember(vaultId) {
      return signedIn()
        && exists(/databases/$(database)/documents/vaultsV2/$(vaultId))
        && request.auth.uid in get(
          /databases/$(database)/documents/vaultsV2/$(vaultId)
        ).data.memberUids;
    }

    // V2 vault root documents
    match /vaultsV2/{vaultId} {

      // A user can read their own vault, or a vault they have joined.
      allow get: if signedIn()
        && (
          vaultId == request.auth.uid
          || isVaultMember(vaultId)
        );

      // Clients cannot enumerate vaults.
      allow list: if false;

      // A user can create only their own initial vault.
      allow create: if signedIn()
        && vaultId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'ownerUid',
          'memberUids',
          'schemaVersion',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'ownerUid',
          'memberUids',
          'schemaVersion',
          'createdAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.schemaVersion == 2
        && request.resource.data.createdAt == request.time;

      // Membership changes must go through trusted Cloud Functions.
      allow update, delete: if false;

      // Member-specific recovery data
      match /members/{memberUid}/recoveryBackups/{backupId} {

        function isOwnApprovedRecoveryPath() {
          return signedIn()
            && memberUid == request.auth.uid
            && isVaultMember(vaultId);
        }

        // The member can read only their own recovery backup.
        allow get: if isOwnApprovedRecoveryPath();
        allow list: if false;

        // Recovery backups are append-only.
        allow create: if isOwnApprovedRecoveryPath()
          && request.resource.data.keys().hasAll([
            'version',
            'kdf',
            'cipher',
            'salt',
            'nonce',
            'ciphertext',
            'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'version',
            'kdf',
            'cipher',
            'salt',
            'nonce',
            'ciphertext',
            'createdAt'
          ])
          && request.resource.data.version == 2
          && request.resource.data.kdf == 'Argon2id'
          && request.resource.data.cipher == 'AES-256-GCM'
          && request.resource.data.salt is string
          && request.resource.data.salt.size() == 24
          && request.resource.data.nonce is string
          && request.resource.data.nonce.size() == 16
          && request.resource.data.ciphertext is string
          && request.resource.data.ciphertext.size() == 64
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }

      // Pointer to the active recovery backup for this member.
      match /members/{memberUid}/recoveryState/current {

        function isOwnApprovedRecoveryPath() {
          return signedIn()
            && memberUid == request.auth.uid
            && isVaultMember(vaultId);
        }

        function validRecoveryPointer() {
          return request.resource.data.keys().hasAll([
            'activeBackupId',
            'updatedAt'
          ])
            && request.resource.data.keys().hasOnly([
              'activeBackupId',
              'updatedAt'
            ])
            && request.resource.data.activeBackupId is string
            && request.resource.data.activeBackupId.size() > 0
            && request.resource.data.updatedAt == request.time
            && exists(
              /databases/$(database)/documents/vaultsV2/$(vaultId)/members/$(memberUid)/recoveryBackups/$(request.resource.data.activeBackupId)
            );
        }

        allow get: if isOwnApprovedRecoveryPath();
        allow list: if false;

        allow create: if isOwnApprovedRecoveryPath()
          && validRecoveryPointer();

        allow update: if isOwnApprovedRecoveryPath()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['activeBackupId', 'updatedAt'])
          && validRecoveryPointer();

        allow delete: if false;
      }

      // Shared custom document categories. Built-in categories are
      // rendered by the app and are not stored as deletable documents.
      match /documentCategories/{categoryId} {
        allow get, list: if isVaultMember(vaultId);
        allow create: if isVaultMember(vaultId)
          && request.resource.data.keys().hasAll([
            'name', 'nameLower', 'createdByUid', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'name', 'nameLower', 'createdByUid', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 30
          && request.resource.data.nameLower is string
          && request.resource.data.nameLower == request.resource.data.name.lower()
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isVaultMember(vaultId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'nameLower', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 30
          && request.resource.data.nameLower == request.resource.data.name.lower()
          && request.resource.data.updatedAt == request.time;
        // Category deletion is mediated by app logic after confirming
        // no documents are assigned to the category.
        // Deletion is performed by the callable function after it checks
        // that no active or recycled document still uses this category.
        allow delete: if false;
      }

      // Folder metadata. Folder contents remain in the documents collection.
      // A null parentFolderId represents a folder directly under its category.
      match /documentFolders/{folderId} {
        function validFolderRecord() {
          return request.resource.data.keys().hasAll([
            'schemaVersion', 'name', 'nameLower', 'categoryId',
            'parentFolderId', 'ownerUid', 'scope', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'schemaVersion', 'name', 'nameLower', 'categoryId',
            'parentFolderId', 'ownerUid', 'scope', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 30
          && request.resource.data.nameLower == request.resource.data.name.lower()
          && request.resource.data.categoryId is string
          && request.resource.data.categoryId.size() > 0
          && (
            request.resource.data.parentFolderId == null
            || request.resource.data.parentFolderId is string
          )
          && request.resource.data.ownerUid == request.auth.uid
          && (
            request.resource.data.scope == 'PERSONAL'
            || request.resource.data.scope == 'SHARED'
          )
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
        }

        allow get, list: if isVaultMember(vaultId)
          && (
            resource.data.ownerUid == request.auth.uid
            || resource.data.scope == 'SHARED'
          );

        allow create: if isVaultMember(vaultId)
          && validFolderRecord()
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && (
            request.resource.data.parentFolderId == null
            || (
              exists(/databases/$(database)/documents/vaultsV2/$(vaultId)/documentFolders/$(request.resource.data.parentFolderId))
              && get(/databases/$(database)/documents/vaultsV2/$(vaultId)/documentFolders/$(request.resource.data.parentFolderId)).data.categoryId == request.resource.data.categoryId
              && get(/databases/$(database)/documents/vaultsV2/$(vaultId)/documentFolders/$(request.resource.data.parentFolderId)).data.scope == request.resource.data.scope
              && (
                request.resource.data.scope == 'SHARED'
                || get(/databases/$(database)/documents/vaultsV2/$(vaultId)/documentFolders/$(request.resource.data.parentFolderId)).data.ownerUid == request.auth.uid
              )
            )
          );

        allow update: if isVaultMember(vaultId)
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.categoryId == resource.data.categoryId
          && request.resource.data.scope == resource.data.scope
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'nameLower', 'parentFolderId', 'updatedAt'])
          && validFolderRecord()
          && request.resource.data.updatedAt == request.time
          && (
            request.resource.data.parentFolderId == null
            || (
              request.resource.data.parentFolderId != folderId
              && exists(/databases/$(database)/documents/vaultsV2/$(vaultId)/documentFolders/$(request.resource.data.parentFolderId))
              && get(/databases/$(database)/documents/vaultsV2/$(vaultId)/documentFolders/$(request.resource.data.parentFolderId)).data.categoryId == resource.data.categoryId
              && get(/databases/$(database)/documents/vaultsV2/$(vaultId)/documentFolders/$(request.resource.data.parentFolderId)).data.scope == resource.data.scope
              && (
                resource.data.scope == 'SHARED'
                || get(/databases/$(database)/documents/vaultsV2/$(vaultId)/documentFolders/$(request.resource.data.parentFolderId)).data.ownerUid == request.auth.uid
              )
            )
          );

        // Folder deletion stays disabled until a trusted callable validates
        // that the folder has no documents or child folders.
        allow delete: if false;
      }

      // Document metadata. Binary content lives in Firebase Storage.
      match /documents/{documentId} {
        function validDocumentFolder() {
          return !('folderId' in request.resource.data)
            || request.resource.data.folderId == null
            || (
              request.resource.data.folderId is string
              && exists(/databases/$(database)/documents/vaultsV2/$(vaultId)/documentFolders/$(request.resource.data.folderId))
              && get(/databases/$(database)/documents/vaultsV2/$(vaultId)/documentFolders/$(request.resource.data.folderId)).data.categoryId == request.resource.data.categoryId
              && get(/databases/$(database)/documents/vaultsV2/$(vaultId)/documentFolders/$(request.resource.data.folderId)).data.scope == request.resource.data.scope
              && (
                request.resource.data.scope == 'SHARED'
                || get(/databases/$(database)/documents/vaultsV2/$(vaultId)/documentFolders/$(request.resource.data.folderId)).data.ownerUid == request.auth.uid
              )
            );
        }

        function validDocumentRecord() {
          return request.resource.data.keys().hasAll([
            'schemaVersion', 'ownerUid', 'scope', 'title', 'titleLower',
            'categoryId', 'description', 'originalFileName', 'contentType',
            'sizeBytes', 'storagePath', 'uploadedAt', 'updatedAt',
            'isDeleted', 'deletedAt', 'purgeAt'
          ])
          && request.resource.data.keys().hasOnly([
            'schemaVersion', 'ownerUid', 'scope', 'title', 'titleLower',
            'categoryId', 'folderId', 'description', 'originalFileName', 'contentType',
            'sizeBytes', 'storagePath', 'uploadedAt', 'updatedAt',
            'isDeleted', 'deletedAt', 'purgeAt', 'favouriteUids'
          ])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.ownerUid is string
          && (request.resource.data.scope == 'PERSONAL'
            || request.resource.data.scope == 'SHARED')
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 50
          && request.resource.data.titleLower == request.resource.data.title.lower()
          && request.resource.data.categoryId is string
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 50
          && request.resource.data.originalFileName is string
          && request.resource.data.originalFileName.size() > 0
          && request.resource.data.contentType is string
          && request.resource.data.sizeBytes is int
          && request.resource.data.sizeBytes > 0
          && request.resource.data.sizeBytes <= 52428800
          && request.resource.data.storagePath is string
          && request.resource.data.uploadedAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.isDeleted is bool
          && (
            (request.resource.data.isDeleted == false
              && request.resource.data.deletedAt == null
              && request.resource.data.purgeAt == null)
            || (request.resource.data.isDeleted == true
              && request.resource.data.deletedAt is timestamp
              && request.resource.data.purgeAt is timestamp)
          );
        }

        // A member may read their own documents regardless of visibility,
        // and may read documents explicitly marked SHARED from other members.
        // This also allows the owner's duplicate-check query, which filters by
        // ownerUid but intentionally checks both PERSONAL and SHARED records.
        allow get, list: if isVaultMember(vaultId)
          && (
            resource.data.ownerUid == request.auth.uid
            || resource.data.scope == 'SHARED'
          );

        allow create: if isVaultMember(vaultId)
          && validDocumentRecord()
          && validDocumentFolder()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.uploadedAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.isDeleted == false
          && request.resource.data.deletedAt == null
          && request.resource.data.purgeAt == null
          && request.resource.data.storagePath ==
            'vaultsV2/' + vaultId + '/documents/' + request.auth.uid + '/' + documentId;

        // Only the original owner can edit, soft-delete, restore, or update
        // metadata. Clients cannot change ownership or original upload time.
        // Any approved member may change only their own favourite marker.
        // This keeps favourites private to each household member.
        function isOwnFavouriteOnlyUpdate() {
          return isVaultMember(vaultId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favouriteUids'])
            && request.resource.data.favouriteUids is list
            && request.resource.data.favouriteUids.size() <= 2
            && request.resource.data.favouriteUids.removeAll([request.auth.uid])
              == resource.data.get('favouriteUids', []).removeAll([request.auth.uid]);
        }

        allow update: if isOwnFavouriteOnlyUpdate()
          || (
            isVaultMember(vaultId)
            && resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.uploadedAt == resource.data.uploadedAt
            && request.resource.data.storagePath == resource.data.storagePath
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'scope', 'title', 'titleLower', 'categoryId', 'folderId', 'description',
                'originalFileName', 'contentType', 'sizeBytes', 'updatedAt'
              ])
            && validDocumentRecord()
            && validDocumentFolder()
            && request.resource.data.isDeleted == resource.data.isDeleted
            && request.resource.data.deletedAt == resource.data.deletedAt
            && request.resource.data.purgeAt == resource.data.purgeAt
            && request.resource.data.updatedAt == request.time
          );

        // Physical file deletion is restricted to trusted Admin SDK code.
        allow delete: if false;
      }

      // Password records - V2
      match /passwords/{passwordId} {

        function validPasswordScope() {
          return request.resource.data.scope == 'PERSONAL'
            || request.resource.data.scope == 'SHARED';
        }

        function validEncryptedPassword() {
          return request.resource.data.keys().hasAll([
            'schemaVersion',
            'ownerUid',
            'scope',
            'encryptionKeySource',
            'payloadVersion',
            'algorithm',
            'encryptedPayload',
            'createdAt',
            'editedAt'
          ])
            && request.resource.data.keys().hasOnly([
              'schemaVersion',
              'ownerUid',
              'scope',
              'encryptionKeySource',
              'payloadVersion',
              'algorithm',
              'encryptedPayload',
              'createdAt',
              'editedAt'
            ])
            && request.resource.data.schemaVersion == 2
            && request.resource.data.ownerUid is string
            && request.resource.data.scope is string
            && validPasswordScope()
            && (
              (
                request.resource.data.scope == 'PERSONAL'
                && request.resource.data.encryptionKeySource == 'MEMBER_MASTER'
              )
              ||
              (
                request.resource.data.scope == 'SHARED'
                && request.resource.data.encryptionKeySource == 'HOUSEHOLD'
              )
            )
            && request.resource.data.payloadVersion == 2
            && request.resource.data.algorithm == 'AES-256-GCM'
            && request.resource.data.encryptedPayload is string
            && request.resource.data.encryptedPayload.size() >= 40
            && request.resource.data.encryptedPayload.size() <= 100000
            && request.resource.data.createdAt is timestamp
            && request.resource.data.editedAt is timestamp;
        }

        // Household members can read shared records.
        // Personal records are readable only by their owner.
        allow get, list: if isVaultMember(vaultId)
          && (
            resource.data.scope == 'SHARED'
            || (
              resource.data.scope == 'PERSONAL'
              && resource.data.ownerUid == request.auth.uid
            )
          );

        // A user can create a password record only in their own name.
        allow create: if isVaultMember(vaultId)
          && validEncryptedPassword()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.editedAt == request.time;

        // Only the original creator can update a record, including
        // changing its scope between PERSONAL and SHARED.
        allow update: if isVaultMember(vaultId)
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['scope', 'encryptedPayload', 'editedAt'])
          && validEncryptedPassword()
          && request.resource.data.editedAt == request.time;

        // Only the original creator can delete a record.
        allow delete: if isVaultMember(vaultId)
          && resource.data.ownerUid == request.auth.uid;
      }
    }

    // No direct client access to join codes, membership requests,
    // membership mappings, or legacy collections.
    // All other paths are denied by default.

    function isVaultOwner(vaultId) {
      return signedIn()
        && request.auth.uid == vaultId
        && exists(/databases/$(database)/documents/vaultsV2/$(vaultId))
        && get(/databases/$(database)/documents/vaultsV2/$(vaultId)).data.ownerUid == vaultId;
    }

    function isApprovedSharedDevice(vaultId, memberUid, deviceId) {
      return exists(
          /databases/$(database)/documents/vaultsV2/$(vaultId)/members/$(memberUid)/devices/$(deviceId)
        )
        && get(
          /databases/$(database)/documents/vaultsV2/$(vaultId)/members/$(memberUid)/devices/$(deviceId)
        ).data.status == 'approved'
        && get(
          /databases/$(database)/documents/vaultsV2/$(vaultId)/members/$(memberUid)/devices/$(deviceId)
        ).data.vaultId == vaultId
        && get(
          /databases/$(database)/documents/vaultsV2/$(vaultId)/members/$(memberUid)/devices/$(deviceId)
        ).data.memberUid == memberUid
        && get(
          /databases/$(database)/documents/vaultsV2/$(vaultId)/members/$(memberUid)/devices/$(deviceId)
        ).data.deviceId == deviceId;
    }

    // Device public keys are readable by their member and the vault owner.
    // All writes go through authenticated Cloud Functions.
    match /vaultsV2/{vaultId}/members/{memberUid}/devices/{deviceId} {
      allow get, list: if isVaultMember(vaultId)
        && (request.auth.uid == vaultId || request.auth.uid == memberUid);
      allow create, update, delete: if false;
    }

    // Shared-key envelopes can only be created by the vault owner, and only
    // for a device that has already been explicitly approved. Envelopes are
    // immutable; revocation is handled by a trusted function.
    match /vaultsV2/{vaultId}/members/{memberUid}/sharedKeyEnvelopes/{deviceId} {
      allow get: if isVaultMember(vaultId)
        && (request.auth.uid == vaultId || request.auth.uid == memberUid)
        && isApprovedSharedDevice(vaultId, memberUid, deviceId);
      allow list: if false;
      allow create: if isVaultOwner(vaultId)
        && isVaultMember(vaultId)
        && isApprovedSharedDevice(vaultId, memberUid, deviceId)
        && request.resource.data.keys().hasAll([
          'vaultId', 'memberUid', 'deviceId', 'keyVersion',
          'algorithm', 'wrappedKey', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'vaultId', 'memberUid', 'deviceId', 'keyVersion',
          'algorithm', 'wrappedKey', 'createdAt'
        ])
        && request.resource.data.vaultId == vaultId
        && request.resource.data.memberUid == memberUid
        && request.resource.data.deviceId == deviceId
        && request.resource.data.keyVersion is int
        && request.resource.data.keyVersion > 0
        && request.resource.data.algorithm == 'RSA-OAEP-256'
        && request.resource.data.wrappedKey is string
        && request.resource.data.wrappedKey.size() >= 300
        && request.resource.data.wrappedKey.size() <= 2048
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
